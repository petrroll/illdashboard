# Copy to backend/.env and supply your own credentials. Never commit .env.
# GitHub token with Copilot access (needed for AI processing, not server startup).
GITHUB_TOKEN=

# Terra balances general-purpose summary quality and cost; Luna keeps bulk work
# lightweight. These are configured defaults, not verified account availability.
COPILOT_DEFAULT_MODEL=gpt-5.6-terra
COPILOT_MEASUREMENT_EXTRACTION_MODEL=gpt-6-luna
COPILOT_TEXT_EXTRACTION_MODEL=gpt-6-luna
COPILOT_NORMALIZATION_MODEL=gpt-6-luna
# Leave COPILOT_*_REASONING_EFFORT unset to preserve each model's default reasoning.

# Optional alternative extraction/normalization provider:
# MISTRAL_API_KEY=
# EXTRACTION_PROVIDER=mistral
# NORMALIZATION_PROVIDER=mistral
